<?xml version="1.0" encoding="UTF-8" ?>
<!-- Crêpe du chef styles, applied with StyleClass. Mirrors the Avalonia app styles
     (Styles/Controls in CrepeDuChef.Avalonia). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Pages -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True" Class="page">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WindowLight}, Dark={StaticResource WindowDark}}" />
    </Style>

    <!-- Text -->
    <Style TargetType="Label" Class="title">
        <Setter Property="FontFamily" Value="SalonDuChocolat" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style TargetType="Label" Class="heading">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="sessionTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style TargetType="Label" Class="body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="strong">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style TargetType="Label" Class="caption">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <!-- Containers -->
    <Style TargetType="Border" Class="card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Shadow">
            <Shadow Brush="#7A4A10" Offset="0,4" Radius="14" Opacity="0.10" />
        </Setter>
    </Style>

    <!-- A row inside a card; today's crepe party gets a golden highlight through a DataTrigger -->
    <Style TargetType="Border" Class="row">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style TargetType="Border" Class="avatar">
        <Setter Property="WidthRequest" Value="38" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 19" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GoldSoftLight}, Dark={StaticResource GoldSoftDark}}" />
    </Style>

    <Style TargetType="Label" Class="avatarText">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnGoldLight}, Dark={StaticResource OnGoldDark}}" />
    </Style>

    <Style TargetType="Border" Class="badge">
        <Setter Property="BackgroundColor" Value="{StaticResource Gold}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" Class="badgeText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnBadge}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButtonBase" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="TextColor" Value="{StaticResource OnBrand}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver" />
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandPressedLight}, Dark={StaticResource BrandPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" Class="primary" BasedOn="{StaticResource PrimaryButtonBase}" />

    <!-- The big "who is the chef" call to action -->
    <Style TargetType="Button" Class="hero" BasedOn="{StaticResource PrimaryButtonBase}">
        <Setter Property="FontFamily" Value="SalonDuChocolat" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style TargetType="Button" Class="secondary">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GoldSoftLight}, Dark={StaticResource GoldSoftDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnGoldLight}, Dark={StaticResource OnGoldDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver" />
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Gold}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" Class="subtle">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="Entry" Class="field">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Switch" Class="brand">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="ThumbColor" Value="{StaticResource OnBrand}" />
    </Style>

    <!-- Shell flyout -->
    <Style TargetType="Label" Class="shellItem">
        <Setter Property="FontFamily" Value="SalonDuChocolat" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}" />
    </Style>

</ResourceDictionary>
