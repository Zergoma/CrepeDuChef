<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="CrepeDuChef.Maui.UI.Popups.Views.ChefFormPopup"
               xmlns:vm="clr-namespace:CrepeDuChef.ViewModels.ViewModels;assembly=CrepeDuChef.ViewModels"
               xmlns:models="clr-namespace:CrepeDuChef.ViewModels.Models;assembly=CrepeDuChef.ViewModels"
               x:DataType="vm:ChefEditorViewModel"
               x:TypeArguments="models:ChefFormData"
               BackgroundColor="Transparent"
               Margin="0"
               Padding="0">

    <Border StyleClass="card" Padding="22" WidthRequest="340">
        <VerticalStackLayout Spacing="16">
            <HorizontalStackLayout Spacing="10">
                <Image Source="icon_chef_hat.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                    </Image.Behaviors>
                </Image>
                <Label StyleClass="heading" Text="{Binding Title}" VerticalOptions="Center" LineBreakMode="WordWrap" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label StyleClass="caption" Text="{Binding FirstNameMsg}" />
                <Border StyleClass="row" Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}" Padding="8,0">
                    <Entry StyleClass="field" Text="{Binding FirstName}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label StyleClass="caption" Text="{Binding LastNameMsg}" />
                <Border StyleClass="row" Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}" Padding="8,0">
                    <Entry StyleClass="field" Text="{Binding LastName}" />
                </Border>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                <Button StyleClass="subtle" Text="{Binding CancelMsg}" Command="{Binding CancelCommand}" />
                <Button StyleClass="primary" Text="{Binding ValidateMsg}" Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
