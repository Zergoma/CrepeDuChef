<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:local="clr-namespace:CrepeDuChef.Maui.UI.Popups.Views"
               x:DataType="local:MessagePopup"
               x:Class="CrepeDuChef.Maui.UI.Popups.Views.MessagePopup"
               BackgroundColor="Transparent"
               Margin="0"
               Padding="0">

    <Border StyleClass="card" Padding="22" WidthRequest="340">
        <VerticalStackLayout Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <!-- Tinted from code: behaviors do not inherit the binding context -->
                <Image x:Name="KindIcon" Source="{Binding IconSource}" WidthRequest="36" HeightRequest="36" VerticalOptions="Start" />

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label StyleClass="heading" Text="{Binding Title}" LineBreakMode="WordWrap" />
                    <Label StyleClass="caption" FontSize="14" Text="{Binding Message}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <Button StyleClass="primary" Text="{Binding OkMsg}" HorizontalOptions="End" MinimumWidthRequest="96"
                    Clicked="OkButton_Clicked" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
