<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:local="clr-namespace:CrepeDuChef.Maui.PopupElements"
               x:DataType="local:TitledMessagePopup"
               x:Class="CrepeDuChef.Maui.PopupElements.TitledMessagePopup"
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
               Margin="0"
               Padding="0">

    <Border class="chocoBorder">
        
        <VerticalStackLayout Spacing="10"
                             WidthRequest="350">
        <Label Text="{Binding Title}" 
               FontAttributes="Bold" 
               FontSize="Large"
               FontFamily="SalonDuChocolat"
               class="chocoItemLabel"
               HorizontalOptions="Start"/>
            
            <Label Text="{Binding Message}" FontSize="Small"
                   class="chocoLabelPopup"
                   HorizontalOptions="Start"
                   LineBreakMode="WordWrap"
                   Margin="10,20,10,30"/>

            <Button Text="OK" class="chocoButtonPopup" Clicked="OkButton_Clicked"/>
        </VerticalStackLayout>
    </Border>
    
</toolkit:Popup>