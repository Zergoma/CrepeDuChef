<Project Sdk="Microsoft.NET.Sdk">

  <!-- Strongly typed resource classes are generated at build time, whatever the IDE -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\UiResources.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>CrepeDuChef.Localization.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>UiResources</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)UiResources.g.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ValidationResources.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>CrepeDuChef.Localization.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>ValidationResources</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)ValidationResources.g.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
