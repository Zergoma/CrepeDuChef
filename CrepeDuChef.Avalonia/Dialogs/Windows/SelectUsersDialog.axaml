<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CrepeDuChef.Avalonia.Dialogs.Windows.SelectUsersDialog"
        xmlns:vm="using:CrepeDuChef.ViewModels.ViewModels"
        xmlns:models="using:CrepeDuChef.ViewModels.Models"
        x:DataType="vm:SelectChefsDialogViewModel"
        Width="400"
        Height="400"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <StackPanel Margin="20" Spacing="20">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="16"/>

        <ScrollViewer Height="200">
            <ItemsControl ItemsSource="{Binding Chefs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SelectableChef">
                        <CheckBox
                            Content="{Binding Chef.FullName}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <StackPanel Orientation="Horizontal" Margin="20" Spacing="20">
            <Button Content="{Binding ValidateMsg}"
                    Command="{Binding ValidateCommand}"/>


            <Button Content="{Binding CancelMsg}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>

    </StackPanel>

</Window>
