<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:CrepeDuChef.Avalonia.Converters"
             x:Class="CrepeDuChef.Avalonia.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the system light/dark theme -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CrepeDuChef.Avalonia/Styles/Theme/Palette.axaml"/>
        <ResourceInclude Source="avares://CrepeDuChef.Avalonia/Styles/Theme/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>

      <conv:InitialsConverter x:Key="InitialsConverter"/>
      <conv:IsTodayConverter x:Key="IsTodayConverter"/>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent controls (toggles, check boxes, focus) take the brand colors -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#E03131" RegionColor="#FFF8EE"/>
        <ColorPaletteResources x:Key="Dark" Accent="#F04A4A" RegionColor="#1E1814"/>
      </FluentTheme.Palettes>
    </FluentTheme>

    <StyleInclude Source="avares://CrepeDuChef.Avalonia/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>
