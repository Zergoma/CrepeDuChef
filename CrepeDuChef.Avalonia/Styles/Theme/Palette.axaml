<!-- Crêpe du chef colors: brick red brand, golden crepe accents, warm cream surfaces.
     Every style and view uses these keys (DynamicResource) so light and dark themes follow. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BrandBrush" Color="#E03131"/>
      <SolidColorBrush x:Key="BrandHoverBrush" Color="#C92A2A"/>
      <SolidColorBrush x:Key="BrandPressedBrush" Color="#A61E1E"/>
      <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="GoldBrush" Color="#F4BC55"/>
      <SolidColorBrush x:Key="GoldSoftBrush" Color="#FCE8BE"/>
      <SolidColorBrush x:Key="GoldSoftHoverBrush" Color="#F9DA98"/>
      <SolidColorBrush x:Key="OnGoldBrush" Color="#7A4A10"/>

      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF8EE"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FDF3E3"/>
      <SolidColorBrush x:Key="CardBorderBrush" Color="#F1E2C9"/>

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3B2A1E"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A715C"/>

      <SolidColorBrush x:Key="SidebarBrush" Color="#E03131"/>
      <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="#26FFFFFF"/>
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#E03131"/>

      <SolidColorBrush x:Key="TodayBrush" Color="#FFF1C9"/>
      <SolidColorBrush x:Key="TodayBorderBrush" Color="#F4BC55"/>

      <SolidColorBrush x:Key="SuccessBrush" Color="#2F9E44"/>
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E3F6E7"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#E8590C"/>
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFEBDD"/>
      <SolidColorBrush x:Key="ErrorBrush" Color="#C92A2A"/>
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FDE2E2"/>

      <BoxShadows x:Key="CardShadow">0 4 18 0 #1A7A4A10</BoxShadows>
      <BoxShadows x:Key="ButtonShadow">0 6 16 0 #40E03131</BoxShadows>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BrandBrush" Color="#F04A4A"/>
      <SolidColorBrush x:Key="BrandHoverBrush" Color="#F46B6B"/>
      <SolidColorBrush x:Key="BrandPressedBrush" Color="#D63A3A"/>
      <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="GoldBrush" Color="#F4BC55"/>
      <SolidColorBrush x:Key="GoldSoftBrush" Color="#4A3820"/>
      <SolidColorBrush x:Key="GoldSoftHoverBrush" Color="#5C4628"/>
      <SolidColorBrush x:Key="OnGoldBrush" Color="#FCD78A"/>

      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1814"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#2A221C"/>
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#342A22"/>
      <SolidColorBrush x:Key="CardBorderBrush" Color="#43352A"/>

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F6EBDD"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BFA78F"/>

      <SolidColorBrush x:Key="SidebarBrush" Color="#3A1D1A"/>
      <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#F6EBDD"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#F04A4A"/>
      <SolidColorBrush x:Key="SidebarSelectedForegroundBrush" Color="#FFFFFF"/>

      <SolidColorBrush x:Key="TodayBrush" Color="#45361D"/>
      <SolidColorBrush x:Key="TodayBorderBrush" Color="#C9963C"/>

      <SolidColorBrush x:Key="SuccessBrush" Color="#69DB7C"/>
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#21362A"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#FFA94D"/>
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#3E2C1C"/>
      <SolidColorBrush x:Key="ErrorBrush" Color="#FF8787"/>
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#3F2222"/>

      <BoxShadows x:Key="CardShadow">0 4 18 0 #40000000</BoxShadows>
      <BoxShadows x:Key="ButtonShadow">0 6 16 0 #40000000</BoxShadows>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="TitleFontFamily">avares://CrepeDuChef.Avalonia/Assets/Fonts#Salon du Chocolat</FontFamily>

</ResourceDictionary>
