<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:CrepeDuChef.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:i="using:Avalonia.Xaml.Interactivity"
			 xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="CrepeDuChef.Avalonia.Views.UserSettingsView"
			 xmlns:vm="using:CrepeDuChef.ViewModels.ViewModels"
			 x:DataType="vm:UserSettingViewModel"
			 xmlns:dto="using:CrepeDuChef.Application.DTOs">



	<StackPanel Margin="20" Spacing="10">

		<!-- Titre -->
		<TextBlock Text="{Binding UserSettingMsg}"
				   FontSize="24"
				   FontWeight="Bold"/>

		<!-- Bouton Add -->
		<Button Content="Add"
				Command="{Binding AddUserCommand}"
				Width="150"/>

		<!-- Liste des users -->
		<ListBox ItemsSource="{Binding Users}"
				 HorizontalAlignment="Center"
				 SelectedItem="{Binding SelectedUser}"
				 SelectionMode="Single">

			<i:Interaction.Behaviors>
				<ia:EventTriggerBehavior EventName="SelectionChanged">
					<ia:InvokeCommandAction Command="{Binding UserUpdateCommand}" />
				</ia:EventTriggerBehavior>
			</i:Interaction.Behaviors>

			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="dto:UserDto">
					<TextBlock Text="{Binding FullName}" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>


</UserControl>
