<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="CrepeDuChef.Avalonia.Views.MainWindow"
		Title="CrepeDuChef.Avalonia"
		xmlns:vm="using:CrepeDuChef.Avalonia.ViewModels"
		x:DataType="vm:MainViewModel">

	<SplitView IsPaneOpen="True"
			   DisplayMode="CompactInline"
			   CompactPaneLength="60"
			   OpenPaneLength="200">

		<SplitView.Pane>
			<StackPanel>
				<Button Content="{Binding CrepePartyMsg}"
						Classes="menu-button"
						Command="{Binding GoToCrepePartyCommand}" />

				<Button Content="{Binding UsersMsg}"
						Classes="menu-button"
						Command="{Binding GoToUserCommand}" />
			</StackPanel>
		</SplitView.Pane>

		<ContentPresenter Content="{Binding CurrentView}"/>
	</SplitView>
</Window>
