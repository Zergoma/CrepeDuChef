<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="CrepeDuChef.Avalonia.Views.MainWindow"
		Title="CrepeDuChef.Avalonia"
		xmlns:vm="using:CrepeDuChef.Avalonia.ViewModels"
		xmlns:sharedVm="using:CrepeDuChef.ViewModels.ViewModels"
		xmlns:views="using:CrepeDuChef.Avalonia.Views"
		x:DataType="vm:MainViewModel">

	<Window.DataTemplates>
		<DataTemplate DataType="sharedVm:CrepeSessionsViewModel">
			<views:CrepeSessionsView />
		</DataTemplate>
		<DataTemplate DataType="sharedVm:ChefSettingsViewModel">
			<views:UserSettingsView />
		</DataTemplate>
	</Window.DataTemplates>

	<SplitView IsPaneOpen="True"
			   DisplayMode="CompactInline"
			   CompactPaneLength="60"
			   OpenPaneLength="200">

		<SplitView.Pane>
			<StackPanel>
				<Button Content="{Binding CrepePartyMsg}"
						Classes="menu-button"
						Command="{Binding GoToCrepePartyCommand}" />

				<Button Content="{Binding UsersMsg}"
						Classes="menu-button"
						Command="{Binding GoToChefsCommand}" />
			</StackPanel>
		</SplitView.Pane>

		<ContentControl Content="{Binding CurrentPage}"/>
	</SplitView>
</Window>
