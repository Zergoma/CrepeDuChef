<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="CrepeDuChef.Avalonia.Views.CrepeSessionsView"
			 xmlns:vm="using:CrepeDuChef.ViewModels.ViewModels"
			 x:DataType="vm:CrepeSessionsViewModel"
			 xmlns:models="using:CrepeDuChef.ViewModels.Models">
	<Grid RowDefinitions="Auto, Auto, *" Margin="20">

		<StackPanel>

			<!-- Header -->
			<TextBlock
			Text="{Binding CrepeDuChef_title}"
			FontSize="24"
			FontWeight="Bold"
			Margin="0 0 0 20" />

			<Button
			Content="{Binding WhoIsTheChef}"
			Command="{Binding GetNewChefCommand}"
			Width="240"
			Height="100"
			CornerRadius="30"
			HorizontalContentAlignment="Center"
			VerticalContentAlignment="Center"
			HorizontalAlignment="Center"/>
		</StackPanel>


		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
			<ToggleSwitch IsChecked="{Binding ShowOnlyCurrent}"
						  OnContent="{Binding OnContentOnlyCurrentSession}"
						  OffContent="{Binding OffOnContentAllSession}"/>
		</StackPanel>


		<!-- Content -->
		<Grid Grid.Row="2" ColumnDefinitions="*, Auto">

			<!-- Sessions -->
			<ListBox ItemsSource="{Binding Sessions}"
					 Margin="0 0 20 0">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="models:CrepePartySessionGroup">
						<StackPanel Margin="0 0 0 20">

							<!-- Session header -->
							<TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />

							<!-- Session entries -->
							<ItemsControl ItemsSource="{Binding}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:CrepePartyEntryItem">
										<StackPanel Orientation="Horizontal" Margin="10 0 0 5">
											<TextBlock Text="{Binding ChefName}" />
											<TextBlock Text=" - " />
											<TextBlock Text="{Binding DateLocal}" />
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!-- Actions -->
			<StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">

				<Button Content="{Binding UsersAway}"
						Command="{Binding SelectAvailableChefsCommand}"
						IsEnabled="{Binding IsMoreThanOneChef}" />

			</StackPanel>


		</Grid>
	</Grid>
</UserControl>
