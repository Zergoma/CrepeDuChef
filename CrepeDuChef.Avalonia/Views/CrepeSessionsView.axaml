<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="768" d:DesignHeight="720"
             x:Class="CrepeDuChef.Avalonia.Views.CrepeSessionsView"
             xmlns:vm="using:CrepeDuChef.ViewModels.ViewModels"
             xmlns:models="using:CrepeDuChef.ViewModels.Models"
             x:DataType="vm:CrepeSessionsViewModel">

  <ScrollViewer>
    <StackPanel MaxWidth="760" Margin="32" Spacing="22">

      <!-- Draw -->
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="16">
          <Button Classes="primary hero"
                  Command="{Binding GetNewChefCommand}"
                  IsEnabled="{Binding CanUpdate}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <PathIcon Data="{StaticResource ChefHatIcon}"/>
              <TextBlock Text="{Binding WhoIsTheChef}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="caption" Text="{Binding PresentChefsMsg}" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding SelectAvailableChefsCommand}"
                    IsVisible="{Binding IsMoreThanOneChef}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource AwayIcon}"/>
                <TextBlock Text="{Binding ChefsAwayMsg}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- History -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Data="{StaticResource HistoryIcon}" Width="20" Height="20"
                  Foreground="{DynamicResource BrandBrush}" Margin="0 0 10 0"/>
        <TextBlock Grid.Column="1" Classes="heading" Text="{Binding HistoryMsg}" VerticalAlignment="Center"/>
        <ToggleSwitch Grid.Column="2"
                      IsChecked="{Binding ShowOnlyCurrent}"
                      OnContent="{Binding OnContentOnlyCurrentSession}"
                      OffContent="{Binding OffOnContentAllSession}"/>
      </Grid>

      <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding HasSessions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="16"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:CrepePartySessionGroup">
            <Border Classes="card" Padding="16 14">
              <StackPanel Spacing="6">
                <TextBlock Classes="heading" Text="{Binding Title}"
                           Foreground="{DynamicResource BrandBrush}" Margin="4 0 0 4"/>

                <ItemsControl ItemsSource="{Binding}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CrepePartyEntryItem">
                      <Border Classes="row"
                              Classes.today="{Binding DateLocal, Converter={StaticResource IsTodayConverter}}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Classes="avatar">
                            <TextBlock Text="{Binding ChefName, Converter={StaticResource InitialsConverter}}"/>
                          </Border>
                          <TextBlock Grid.Column="1" Classes="strong" Text="{Binding ChefName}"
                                     VerticalAlignment="Center" Margin="12 0"/>
                          <Border Grid.Column="2" Classes="badge" Margin="0 0 12 0"
                                  IsVisible="{Binding DateLocal, Converter={StaticResource IsTodayConverter}}">
                            <TextBlock Text="{Binding $parent[UserControl].((vm:CrepeSessionsViewModel)DataContext).TodayMsg}"/>
                          </Border>
                          <TextBlock Grid.Column="3" Classes="caption"
                                     Text="{Binding DateLocal, StringFormat='{}{0:dddd d MMMM yyyy}'}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- No crepe party yet -->
      <Border Classes="card" IsVisible="{Binding !HasSessions}">
        <StackPanel Classes="empty">
          <PathIcon Data="{StaticResource ChefHatIcon}"/>
          <TextBlock Text="{Binding NoSessionInDb}"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
